{
  "name": "@datalabrotterdam/nova-sdk",
  "version": "1.3.2",
  "description": "TypeScript client for the Nova AI API",
  "license": "MIT",
  "homepage": "https://git.datalabrotterdam.nl/datalab-rotterdam/services/nova-ai-gateway",
  "bugs": {
    "url": "https://git.datalabrotterdam.nl/datalab-rotterdam/services/nova-ai-gateway/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.datalabrotterdam.nl/datalab-rotterdam/services/nova-ai-gateway.git",
    "directory": "packages/typescript/client-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "vite build",
    "docs": "typedoc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "typedoc": "^0.28.13",
    "typescript": "^5.5.4",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "@sourceregistry/semantic-release-jsr": "^1.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
